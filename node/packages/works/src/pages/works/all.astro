---
import { WorksAll } from "../../components/pages/works.all";
import type { Props } from "../../components/pages/works";

import { Head } from "../../components/parts/head";
import HTML from "../../layouts/html.astro";
import { ArticleLayout } from "../../layouts/articleLayout";
import { getWorks } from "../../api/notion/works";

const works = await getWorks();
---

<HTML>
  <Fragment slot="head">
    <Head title="All works - ichi-h.com" url="/works/all" ogType="article" />
  </Fragment>
  <Fragment slot="content">
    <ArticleLayout title="All works">
      <WorksAll works={works} />
    </ArticleLayout>
  </Fragment>
</HTML>
