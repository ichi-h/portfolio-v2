---
import { Works } from "../../components/pages/works";
import type { Props } from "../../components/pages/works";

import { Head } from "../../components/parts/head";
import HTML from "../../layouts/html.astro";
import { ArticleLayout } from "../../layouts/articleLayout";
import { getWorks } from "../../api/notion/works";

const categories = ["philosophy", "literature", "music", "photograph", "life"];

const pickups = await getWorks({ pinned: true });

const latestWorks = (await getWorks()).slice(0, 6);

const worksByCategory: Props["worksByCategory"] = await Promise.all(
  categories.map(async (category) => {
    const works = (await getWorks({ category })).slice(0, 6);
    return { category, works };
  }),
);
---

<HTML>
  <Fragment slot="head">
    <Head title="Works - ichi-h.com" url="/works" ogType="article" />
  </Fragment>
  <Fragment slot="content">
    <ArticleLayout title="Works">
      <Works
        pickups={pickups}
        latestWorks={latestWorks}
        worksByCategory={worksByCategory}
      />
    </ArticleLayout>
  </Fragment>
</HTML>
